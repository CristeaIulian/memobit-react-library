{
  "name": "@memobit/libs",
  "version": "3.6.0",
  "description": "React component library powering the Memobit apps — 100+ components, helpers and hooks. Icons ship as @memobit/icons and themes as @memobit/themes. TypeScript-first, ESM-only, React 19.",
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "ui",
    "ui-kit",
    "design-system",
    "typescript",
    "hooks",
    "memobit"
  ],
  "author": "Iulian Cristea <iulianx@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://react.memobit.ro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristeaIulian/memobit-react-library.git"
  },
  "bugs": {
    "url": "https://github.com/CristeaIulian/memobit-react-library/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./mfa": {
      "types": "./dist/mfa.d.ts",
      "import": "./dist/mfa.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./dist/styles/variables.scss": "./dist/styles/variables.scss",
    "./dist/styles/base.scss": "./dist/styles/base.scss",
    "./dist/styles/effects.scss": "./dist/styles/effects.scss",
    "./dist/styles/highlight.scss": "./dist/styles/highlight.scss",
    "./dist/styles/scrollbars.scss": "./dist/styles/scrollbars.scss",
    "./dist/styles/utilities.scss": "./dist/styles/utilities.scss",
    "./dist/styles/utility-classes.scss": "./dist/styles/utility-classes.scss",
    "./dist/components/*": "./dist/components/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && npm pack",
    "release": "npm run build && npm publish",
    "check:npm-auth": "node scripts/check-npm-auth.mjs",
    "ship": "npm run check:npm-auth && npm version patch && npm run release && git push --follow-tags",
    "ship:minor": "npm run check:npm-auth && npm version minor && npm run release && git push --follow-tags",
    "ship:major": "npm run check:npm-auth && npm version major && npm run release && git push --follow-tags",
    "prepublishOnly": "vite build",
    "dev": "vite build --watch",
    "playground": "vite serve playground --config playground/vite.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\""
  },
  "peerDependencies": {
    "@memobit/icons": "^1.0.0",
    "@memobit/themes": "^1.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@memobit/icons": "file:../memobit-react-icons",
    "@memobit/themes": "file:../memobit-react-themes",
    "@microsoft/api-extractor": "7.59.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sass": "1.105.0",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-dts": "5.1.1",
    "vite-plugin-static-copy": "4.1.1"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "esbuild": "0.28.2",
    "fast-uri@3": "3.1.8",
    "immutable": "5.1.9",
    "js-yaml": "4.3.2",
    "minimatch@10": "10.2.6",
    "nanoid@3": "3.3.18",
    "picomatch@2": "2.3.2",
    "postcss": "8.5.28",
    "source-map-js": "1.2.2"
  }
}
